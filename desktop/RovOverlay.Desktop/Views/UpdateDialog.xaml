<Window x:Class="RovOverlay.Desktop.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:RovOverlay.Desktop.Services"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Margin="18" Padding="24,20,24,18" CornerRadius="8" BorderThickness="1"
            Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}"
            RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="{svc:T Update.WhatsNew}" Margin="0,16,0,6"/>
            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="14,10" MaxHeight="300">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NotesPanel"/>
                </ScrollViewer>
            </Border>

            <!-- What is about to happen, before it happens. The overlays go dark for a few
                 seconds, which is the whole reason this asks rather than just doing it. -->
            <Border Background="{StaticResource GoldSoftBrush}" BorderBrush="{StaticResource GoldLineBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="14,11" Margin="0,12,0,0">
                <StackPanel x:Name="WarnPanel"/>
            </Border>

            <TextBlock x:Name="LaterNote" Style="{StaticResource MutedText}" FontSize="11.5"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="LaterButton" MinWidth="120" Click="Later_Click"/>
                <Button x:Name="NowButton" MinWidth="150" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}" Click="Now_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

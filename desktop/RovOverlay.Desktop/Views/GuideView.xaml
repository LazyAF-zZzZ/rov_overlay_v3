<UserControl x:Class="RovOverlay.Desktop.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:RovOverlay.Desktop.Services">
    <Grid Margin="22,18,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding OpenWebCommand}" Padding="10,0"
                    ToolTip="{svc:T Guide.OpenWebTip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Margin="0,0,7,0"/>
                    <TextBlock Text="{svc:T Common.OpenBrowser}"/>
                </StackPanel>
            </Button>
            <Grid DockPanel.Dock="Right" Width="240" Margin="0,0,8,0">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="28,4,7,4" Tag="{svc:T Guide.Search}"/>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock Style="{StaticResource PageTitle}" Text="{svc:T Nav.Guide}" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisInv}}">
            <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" MaxWidth="900" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Blocks}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="heading">
                                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Margin" Value="0,8,0,4"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="bullet">
                                                                <Setter Property="Margin" Value="16,0,0,5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="number">
                                                                <Setter Property="Margin" Value="16,0,0,5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="code">
                                                                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                                                <Setter Property="FontSize" Value="11.5"/>
                                                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

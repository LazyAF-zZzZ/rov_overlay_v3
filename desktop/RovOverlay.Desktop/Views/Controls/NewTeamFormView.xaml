<UserControl x:Class="RovOverlay.Desktop.Views.Controls.NewTeamFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:RovOverlay.Desktop.Services"
             xmlns:ctl="clr-namespace:RovOverlay.Desktop.Views.Controls">
    <!-- DataContext: a NewTeamForm. The host page supplies the Create button, because
         it means "create" on the registry and "create and add" in a tournament. -->
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{svc:T Team.Name}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" Tag="Flash Wolves"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{svc:T Team.Tag}"/>
                <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Tag="FW"/>
            </StackPanel>
            <Button Grid.Column="4" VerticalAlignment="Bottom" Command="{Binding ChooseLogoCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="12" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding LogoText}"/>
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock Style="{StaticResource FieldLabel}" Text="{svc:T Team.PlayersLabel}" Margin="0,12,0,6"/>
        <ctl:PlayerEditorView DataContext="{Binding Players}"/>
    </StackPanel>
</UserControl>

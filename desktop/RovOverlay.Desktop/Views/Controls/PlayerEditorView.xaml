<UserControl x:Class="RovOverlay.Desktop.Views.Controls.PlayerEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RovOverlay.Desktop.ViewModels"
             xmlns:svc="clr-namespace:RovOverlay.Desktop.Services">
    <!-- DataContext: a PlayerEditor. Each captain radio sits in its own row, so WPF does
         not group them; PlayerEditor keeps it to one captain. -->
    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Slot}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                               FontFamily="{StaticResource MonoFont}"/>
                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="24"
                             Tag="{Binding Placeholder}"/>
                    <ComboBox Grid.Column="2" Margin="8,0,0,0" ItemsSource="{x:Static vm:PlayerEditor.Positions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Position}"/>
                    <RadioButton Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center"
                                 IsChecked="{Binding IsCaptain}" Content="{svc:T Team.Captain}"/>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>

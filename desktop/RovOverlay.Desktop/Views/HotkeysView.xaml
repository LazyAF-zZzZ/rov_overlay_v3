<UserControl x:Class="RovOverlay.Desktop.Views.HotkeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:RovOverlay.Desktop.Services">
    <UserControl.Resources>
        <DataTemplate x:Key="HotkeyRowTemplate">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Margin="0,2,0,0" Visibility="{Binding Note, Converter={StaticResource NullToVis}}"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,2,0,0"
                                   Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="1" CornerRadius="4" Padding="10,5" Margin="10,0" BorderThickness="1"
                            Background="{StaticResource Surface0Brush}" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Recording}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                        <Setter Property="Background" Value="{StaticResource GoldSoftBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource GoldLineBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding KeyText}" TextAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding RecordLabel}" Command="{Binding RecordCommand}" Padding="12,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="{svc:T Hotkeys.Default}" Command="{Binding DefaultCommand}"
                                Padding="10,0" Margin="6,0,0,0"
                                Visibility="{Binding IsChanged, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,24" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{svc:T Nav.Hotkeys}"/>

            <!-- Control Panel keys -->
            <DockPanel Margin="0,20,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="{svc:T Hotkeys.ResetAll}"
                        Command="{Binding ResetLocalCommand}"/>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Hotkeys.Local}" VerticalAlignment="Center"/>
                <TextBlock Text="{svc:T Hotkeys.LocalNote}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="16,4,16,10">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Local}" ItemTemplate="{StaticResource HotkeyRowTemplate}" Focusable="False"/>
                    <TextBlock Style="{StaticResource MutedText}" Text="{svc:T Hotkeys.LocalHint}" FontSize="11.5" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- System-wide keys -->
            <DockPanel Margin="0,22,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="{svc:T Hotkeys.ResetGlobal}"
                        Command="{Binding ResetGlobalCommand}"/>
                <CheckBox DockPanel.Dock="Right" Content="{svc:T Hotkeys.GlobalEnabled}" IsChecked="{Binding GlobalEnabled}"
                          Margin="0,0,14,0"/>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{svc:T Hotkeys.Global}" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="16,4,16,10">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Global}" ItemTemplate="{StaticResource HotkeyRowTemplate}" Focusable="False">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GlobalEnabled}" Value="False">
                                        <Setter Property="Opacity" Value="0.55"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource MutedText}" Text="{svc:T Hotkeys.GlobalHint}" FontSize="11.5" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<Window x:Class="RovOverlay.Desktop.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Margin="18" Padding="22,20,22,18" CornerRadius="8" BorderThickness="1"
            Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <StackPanel x:Name="BodyPanel" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" MinWidth="90" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" MinWidth="110" Margin="8,0,0,0" Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
